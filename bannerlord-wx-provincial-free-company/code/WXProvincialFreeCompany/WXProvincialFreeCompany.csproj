<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WXProvincialFreeCompany</AssemblyName>
    <RootNamespace>WXProvincialFreeCompany</RootNamespace>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\build\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <BannerlordGameDir Condition="'$(BannerlordGameDir)' == '' and '$(BANNERLORD_GAME_DIR)' != ''">$(BANNERLORD_GAME_DIR)</BannerlordGameDir>
    <BannerlordBinDir>$(BannerlordGameDir)\bin\Win64_Shipping_Client</BannerlordBinDir>
  </PropertyGroup>

  <Target Name="ValidateBannerlordGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(BannerlordGameDir)' == ''"
           Text="BannerlordGameDir is required. Pass -p:BannerlordGameDir=&quot;...&quot; or set BANNERLORD_GAME_DIR." />
    <Error Condition="!Exists('$(BannerlordBinDir)\TaleWorlds.MountAndBlade.dll')"
           Text="BannerlordGameDir does not contain bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.dll: $(BannerlordGameDir)" />
  </Target>

  <ItemGroup>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(BannerlordBinDir)\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordBinDir)\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(BannerlordBinDir)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(BannerlordBinDir)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(BannerlordBinDir)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem.ViewModelCollection">
      <HintPath>$(BannerlordBinDir)\TaleWorlds.CampaignSystem.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
